---
import MetaPage from "@/components/MetaPage.astro"
import PlanCard from "@/components/PlanCard.astro"
import Layout from "@/layouts/Layout.astro"
import {
  groupByStatus,
  type Plan,
  type PlanStatus,
  STATUS_LABEL,
  STATUS_ORDER,
} from "@/lib/now"
import { getCollection } from "astro:content"

const sections = await getCollection("now")
const plans = sections.flatMap(({ id, data }) => {
  const status = id.split("/")[0] as PlanStatus
  if (!STATUS_ORDER.includes(status)) {
    throw new Error(`[now] unknown status directory: "${status}"`)
  }

  return data.plans.map(
    (plan): Plan => ({
      ...plan,
      status,
      addedAt: plan.addedAt.toISOString().slice(0, 10),
      finishedAt: plan.finishedAt?.toISOString().slice(0, 10),
    }),
  )
})

for (const plan of plans) {
  if (plan.status === "shipped" && !plan.finishedAt) {
    console.warn(`[now] shipped plan "${plan.id}" is missing finishedAt`)
  }
}

const groups = groupByStatus(plans)
const counts = Object.fromEntries(
  STATUS_ORDER.map((s) => [s, groups[s].length]),
) as Record<(typeof STATUS_ORDER)[number], number>
---

<Layout>
  <MetaPage slot="head" title="Now" description="What I'm working on now." />
  <header>
    <h1>Now</h1>
    <p>What I'm working on now.</p>
  </header>
  <div class="status-buttons" role="group" aria-label="Plan status">
    {STATUS_ORDER.map((status, i) => (
      <button
        type="button"
        data-status={status}
        aria-pressed={i === 0 ? "true" : "false"}
      >
        {STATUS_LABEL[status]}<sup>{counts[status]}</sup>
      </button>
    ))}
  </div>

  {STATUS_ORDER.map((status, i) => {
    const items = groups[status]
    return (
      <section
        id={`panel-${status}`}
        data-panel={status}
        aria-label={STATUS_LABEL[status]}
        hidden={i !== 0}
      >
        {items.length > 0 ? (
          <ol>
            {items.map((plan, j) => <PlanCard plan={plan} index={j} />)}
          </ol>
        ) : (
          <p class="empty">No plans yet.</p>
        )}
      </section>
    )
  })}
</Layout>

<script>
  const statusBar = document.querySelector<HTMLElement>(".status-buttons")
  const panels = document.querySelectorAll<HTMLElement>("[data-panel]")
  const buttons = statusBar?.querySelectorAll<HTMLButtonElement>(
    "button[data-status]",
  )

  function activate(status: string) {
    for (const button of buttons ?? []) {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.status === status),
      )
    }
    for (const panel of panels) {
      panel.hidden = panel.dataset.panel !== status
    }
    history.replaceState(null, "", `#${status}`)
  }

  statusBar?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
      "button[data-status]",
    )
    if (btn?.dataset.status) activate(btn.dataset.status)
  })

  const initial = location.hash.slice(1)
  if (
    initial &&
    [...(buttons ?? [])].some((button) => button.dataset.status === initial)
  ) {
    activate(initial)
  }
</script>

<style>
  header {
    margin-block-end: var(--space-l);

    h1 {
      font-size: var(--step-3);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
    }

    p {
      margin-block-start: var(--space-2xs);
      color: var(--muted-foreground);
    }
  }

  .status-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-end: var(--space-l);
    border-block-end: 1px solid var(--border);

    button {
      appearance: none;
      cursor: pointer;
      background: none;
      border: none;
      border-block-end: 2px solid transparent;
      padding: var(--space-2xs) var(--space-3xs);
      margin-block-end: -1px;
      font: inherit;
      font-size: var(--step--1);
      color: var(--muted-foreground);
      transition:
        color 0.2s ease,
        border-color 0.2s ease;

      sup {
        margin-inline-start: 0.4em;
        font-size: 0.72em;
        font-variant-numeric: tabular-nums;
        opacity: 0.6;
        font-weight: var(--font-weight-normal);
      }

      &:hover {
        color: var(--foreground);
      }

      &[aria-pressed="true"] {
        color: var(--foreground);
        border-block-end-color: var(--foreground);
      }
    }

    @media (width < 40rem) {
      overflow-x: auto;
      flex-wrap: nowrap;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }
    }
  }

  section[data-panel] {
    &[hidden] {
      display: none;
    }
  }

  ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .empty {
    color: var(--muted-foreground);
    font-size: var(--step--1);
    padding-block: var(--space-s);
  }
</style>
