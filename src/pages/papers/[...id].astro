---
import MetaPost from "@/components/MetaPost.astro"
import ScrollToTop from "@/components/ScrollToTop.astro"
import TableOfContents from "@/components/TableOfContents.astro"
import Layout from "@/layouts/Layout.astro"
import { formatDate } from "@/lib/utils"
import { isFullyAiTag } from "@/lib/tags"
import { Image } from "astro:assets"
import {
  getCollection,
  getEntries,
  render,
  type CollectionEntry,
} from "astro:content"

export async function getStaticPaths() {
  const papers = await getCollection("papers", ({ data }) => !data.draft)
  return papers.map((paper) => ({
    params: { id: paper.id },
    props: { paper },
  }))
}

type Props = { paper: CollectionEntry<"papers"> }

const { paper } = Astro.props
const { Content, headings } = await render(paper)
const authors = await getEntries(paper.data.authors)
const tocHeadings = headings.filter(
  ({ depth, text }) => depth >= 2 && depth <= 4 && text.trim(),
)
const crumbs = [{ label: paper.data.title, href: `/papers/${paper.id}` }]
---

<Layout crumbs={crumbs}>
  <MetaPost slot="head" post={paper} />
  {tocHeadings.length > 0 && (
    <TableOfContents
      slot="toc"
      title={paper.data.title}
      sections={[{ label: paper.data.title, headings: tocHeadings, open: true }]}
    />
  )}
  <ScrollToTop floating />
  <article>
    <header>
      <h1>{paper.data.title}</h1>
      <post-meta>
        {authors.length > 0 && (
          <post-authors>
            <author-avatars>
              {authors.map((author) => (
                <img
                  src={author.data.avatar}
                  alt={author.data.name}
                  width="18"
                  height="18"
                />
              ))}
            </author-avatars>
            <author-names>
              {authors.map((author, i) => (
                <>{i > 0 && ", "}<a href={`/authors/${author.id}`}>{author.data.name}</a></>
              ))}
            </author-names>
          </post-authors>
        )}
        <time datetime={paper.data.date.toISOString()}>
          {formatDate(paper.data.date)}
        </time>
        {paper.data.tags && (
          <post-tags>
            {paper.data.tags.map((tag) => (
              <span
                data-tag-kind={isFullyAiTag(tag) ? "fully-ai" : undefined}
                title={isFullyAiTag(tag) ? "Fully AI-generated" : undefined}
              >
                #{tag}
              </span>
            ))}
          </post-tags>
        )}
      </post-meta>
      <p>{paper.data.description}</p>
    </header>
    {paper.data.image && (
      <post-banner>
        <Image
          src={paper.data.image}
          alt={paper.data.title}
          width={1200}
          height={630}
          priority
        />
      </post-banner>
    )}
    <prose-content>
      <Content />
    </prose-content>
  </article>
</Layout>

<style>
  header {
    margin-block-end: var(--space-m);

    h1 {
      font-size: var(--step-3);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
    }

    post-meta {
      --underline: var(--muted-foreground);

      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3xs);
      margin-block-start: var(--space-3xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);

      post-authors {
        display: flex;
        align-items: center;
        gap: var(--space-3xs);

        author-avatars {
          display: flex;
          margin-block-end: -0.1em;

          img {
            border-radius: var(--radius-full);
            box-shadow: 0 0 0 1.5px var(--background);

            &:not(:first-child) {
              margin-inline-start: -0.375rem;
            }
          }
        }
      }

      post-authors ~ time::before {
        content: "·";
        margin-inline-end: var(--space-3xs);
      }

      post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);

        span {
          color: color-mix(in oklab, var(--muted-foreground) 50%, transparent);
        }
      }

      time ~ post-tags::before {
        content: "·";
      }

      a {
        color: var(--foreground);
      }
    }

    > p {
      margin-block-start: var(--space-2xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }
  }

  post-banner {
    display: block;
    margin-block-end: var(--space-m);

    :global(img) {
      inline-size: 100%;
      block-size: auto;
    }
  }
</style>
