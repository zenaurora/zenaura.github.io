---
import { formatDate } from "@/lib/utils"
import { isFullyAiTag } from "@/lib/tags"
import { Image } from "astro:assets"
import { getEntries, type CollectionEntry } from "astro:content"

type Props = {
  post: CollectionEntry<"blog"> | CollectionEntry<"papers">
  basePath?: "/blog" | "/papers"
}

const { post, basePath = "/blog" } = Astro.props
const authors = await getEntries(post.data.authors)
const isProtected = "protected" in post.data && post.data.protected
---

<li>
  {post.data.image && (
      <a href={`${basePath}/${post.id}`} tabindex="-1" aria-hidden="true">
        <Image src={post.data.image} alt="" width={640} height={336} />
      </a>
    )}
  <entry-info>
    <entry-title>
      <a href={`${basePath}/${post.id}`}>{post.data.title}</a>
      {isProtected && <span aria-label="受密码保护">Locked</span>}
    </entry-title>
    <entry-meta>
      {authors.length > 0 && (
          <entry-authors>
            <author-avatars>
              {authors.map((author) => (
                <img
                  src={author.data.avatar}
                  alt={author.data.name}
                  width="18"
                  height="18"
                />
              ))}
            </author-avatars>
            <author-names>
              {authors.map((author, i) => (
                <>{i > 0 && ", "}{author.data.name}</>
              ))}
            </author-names>
          </entry-authors>
        )}
      <time datetime={post.data.date.toISOString()}
        >{formatDate(post.data.date)}</time
      >
      {post.data.tags && (
          <entry-tags>
            {post.data.tags.map((tag) => (
              <span
                data-tag-kind={isFullyAiTag(tag) ? "fully-ai" : undefined}
                title={isFullyAiTag(tag) ? "Fully AI-generated" : undefined}
              >
                #{tag}
              </span>
            ))}
          </entry-tags>
        )}
    </entry-meta>
    <p>
      {isProtected ? "受密码保护，输入密码后查看内容。" : post.data.description}
    </p>
  </entry-info>
</li>

<style>
  li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);

    > a {
      flex-shrink: 0;
      inline-size: 14rem;

      :global(img) {
        inline-size: 100%;
        block-size: auto;
      }
    }

    entry-info {
      display: flex;
      flex-direction: column;

      entry-title {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-2xs);

        > a {
          font-size: var(--step-1);
          line-height: calc(var(--leading-offset) + 1em);
          font-weight: var(--font-weight-medium);
        }

        > span {
          border: 1px solid var(--border);
          border-radius: var(--radius-full);
          padding: 0.12em 0.55em;
          font-family: var(--font-mono);
          font-size: var(--step--2);
          line-height: 1.4;
          color: var(--muted-foreground);
        }
      }

      entry-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3xs);
        margin-block-end: var(--space-3xs);
        font-size: var(--step--1);
        color: var(--muted-foreground);

        entry-authors {
          display: flex;
          align-items: center;
          gap: var(--space-3xs);

          author-avatars {
            display: flex;
            margin-block-end: -0.1em;

            img {
              border-radius: var(--radius-full);
              box-shadow: 0 0 0 1.5px var(--background);

              &:not(:first-child) {
                margin-inline-start: -0.375rem;
              }
            }
          }
        }

        entry-authors ~ time::before {
          content: "·";
          margin-inline-end: var(--space-3xs);
        }

        entry-tags {
          display: flex;
          flex-wrap: wrap;
          gap: var(--space-3xs);

          span {
            color: color-mix(
              in oklab,
              var(--muted-foreground) 50%,
              transparent
            );
          }
        }

        time ~ entry-tags::before {
          content: "·";
        }
      }

      p {
        color: var(--muted-foreground);
      }
    }

    @media (width < 40rem) {
      flex-direction: column;

      > a {
        inline-size: 100%;
        max-inline-size: 32rem;
      }
    }
  }
</style>
