---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
---

<Layout>
  <MetaPage slot="head" />
  <dictionary-entry class="fade-in">
    <header class="entry-header">
      <h1>mao·kai·he</h1>
      <etymology-span>
        <span class="part-of-speech">dut grad student</span>
      </etymology-span>
    </header>

    <ol class="definitions">
      <li>
        a software engineering grad student at DUT. knows a bit of Rust and TypeScript, still figuring things out.
      </li>
      <li>
        (noun) someone who enjoys open-source software and tweaking dev environments more than is probably healthy.
      </li>
    </ol>
    <hr>
    <prose-content>
      <p>
        I mostly write <strong>Rust</strong>, <strong>TypeScript</strong>, and <strong>Python</strong> these days. Switched from Windows to macOS and Linux a while back, and I probably spend too much time configuring my tools instead of actually using them.
      </p>
      <p>
        My lab work is mostly industry projects, which means a lot of Java and enterprise stuff. But I still read AI papers now and then: NeurIPS, CVPR, ICLR. Not because I have to, just because it's interesting even when the math goes over my head.
      </p>
      <p>
        I try to keep up with the Rust community. RFCs, edition updates, that sort of thing.
        <a href="https://smallcultfollowing.com/babysteps/" target="_blank" rel="noopener noreferrer">Niko Matsakis</a>'
        blog posts and
        <a href="https://www.youtube.com/@Tsoding" target="_blank" rel="noopener noreferrer">Tsoding</a>'s
        streams have probably taught me more about programming than most courses I've taken.
      </p>
      <p>
        Thinking about learning Go at some point. Definitely not looking forward to writing more Java than I have to.
      </p>
    </prose-content>


    <article class="activity-card">
      <div class="activity-heading">
        <span>github activity</span>
        <span class="activity-note">last 365 days</span>
      </div>
      <div class="activity-cells" data-github-activity aria-hidden="true">
        {Array.from({ length: 84 }, () => <i style="--level: 0" />)}
      </div>
      <div class="activity-legend" aria-hidden="true">
        <span>less</span>
        {[0, 1, 2, 3, 4].map((level) => <i style={`--level: ${level}`} />)}
        <span>more</span>
      </div>
      <p class="activity-fallback">couldn't load github activity.</p>
    </article>
  </dictionary-entry>
</Layout>

<style>
  /* 逐段级联入场：位移 + 透明度 + 模糊消散，每块内容错开一拍 */
  .fade-in > * {
    animation: entryFadeIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .fade-in > *:nth-child(2) { animation-delay: 0.08s; }
  .fade-in > *:nth-child(3) { animation-delay: 0.16s; }
  .fade-in > *:nth-child(4) { animation-delay: 0.24s; }
  .fade-in > *:nth-child(5) { animation-delay: 0.32s; }

  @keyframes entryFadeIn {
    from {
      opacity: 0;
      transform: translateY(16px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  dictionary-entry {
    display: block;
    font-size: var(--step-0);
    color: var(--muted-foreground);

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }

    etymology-span {
      opacity: 0.7;
      font-style: italic;
      
      .part-of-speech {
        font-weight: var(--font-weight-normal);
        opacity: 0.8;
      }
    }

    h1 {
      font-size: clamp(2.5rem, 1.9rem + 2.8vw, 3.75rem);
      line-height: 1.04;
      font-weight: 550;
      letter-spacing: -0.03em;
      color: var(--foreground);
      margin-block-end: var(--space-2xs);
    }

    ol {
      margin-block-start: var(--space-xs);
      list-style: none;

      li {
        padding-inline-start: 1.2em;
        text-indent: -1.2em;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;

        &::before {
          content: counter(list-item);
          display: inline-block;
          inline-size: 1.2em;
          text-indent: 0;
          font-weight: var(--font-weight-medium);
        }

        /* 鼠标悬停释义时的微交互 */
        &:hover {
          color: var(--foreground);
          transform: translateX(4px);
        }

        + li {
          margin-block-start: var(--space-3xs);
        }
      }
    }

    hr {
      margin-block: var(--space-m);
      border-block-start: 2px solid var(--border);
    }

    prose-content {
      display: block;
      margin-block-start: var(--space-xs);

      p {
        margin-block-end: var(--space-xs);
        line-height: 1.6;

        strong {
          color: var(--foreground);
          font-weight: var(--font-weight-medium);
        }
      }

      /* 现代感平滑展开的下划线动画 */
      a {
        color: var(--foreground);
        text-decoration: none;
        position: relative;
        transition: color 0.25s ease;

        &::after {
          content: '';
          position: absolute;
          width: 100%;
          transform: scaleX(0);
          height: 1px;
          bottom: -1px;
          left: 0;
          background-color: var(--foreground);
          transform-origin: bottom right;
          transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        &:hover {
          &::after {
            transform: scaleX(1);
            transform-origin: bottom left;
          }
        }
      }
    }
  }

  .activity-card {
    display: block;
    margin-block-start: var(--space-xl);
    padding: var(--space-s);
    border: 1px solid var(--border);
    border-radius: 14px;
    /* 双层质感：顶部发丝高光 + 上深下浅的表面渐变，两套明暗都成立 */
    background: linear-gradient(
      color-mix(in oklab, var(--foreground) 3.5%, transparent),
      color-mix(in oklab, var(--foreground) 1.5%, transparent)
    );
    box-shadow: inset 0 1px 0 color-mix(in oklab, var(--foreground) 7%, transparent);
    transition: border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);

    &:hover {
      border-color: color-mix(in oklab, var(--foreground) 22%, transparent);
    }
  }

  .activity-heading,
  .activity-legend {
    display: flex;
    align-items: center;
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .activity-heading {
    justify-content: space-between;
    margin-block-end: var(--space-xs);
  }

  .activity-heading > :first-child {
    color: var(--foreground);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.01em;
  }

  .activity-note {
    opacity: 0.72;
  }

  .activity-cells {
    display: grid;
    grid-template-rows: repeat(6, 1fr);
    grid-auto-flow: column;
    gap: 3px;
    overflow: hidden;
  }

  .activity-cells i,
  .activity-legend i {
    display: block;
    aspect-ratio: 1;
    border-radius: 2px;
    background: color-mix(in oklab, var(--foreground) calc(8% + var(--level) * 16%), transparent);
  }

  .activity-cells i {
    min-inline-size: 8px;
    transition: transform 0.18s ease, background-color 0.18s ease, box-shadow 0.18s ease;
  }

  .activity-cells i:hover {
    transform: translateY(-1px) scale(1.18);
    background: var(--foreground);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--foreground) 14%, transparent);
  }

  .activity-legend {
    justify-content: flex-end;
    gap: 4px;
    margin-block-start: var(--space-xs);
    font-size: 0.7em;
  }

  .activity-legend i {
    inline-size: 8px;
  }

  /* 请求失败时隐藏格子，只留一句说明 */
  .activity-fallback {
    display: none;
    margin-block-start: var(--space-3xs);
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  .activity-card[data-unavailable] {
    .activity-cells,
    .activity-legend {
      display: none;
    }

    .activity-fallback {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fade-in > * {
      animation: none;
    }
  }
</style>

<script>
  const username = "zenaurora"
  const grid = document.querySelector("[data-github-activity]")

  if (grid) {
    fetch(`https://github-contributions-api.jogruber.de/v4/${username}?y=last`)
      .then((response) => {
        if (!response.ok) throw new Error("GitHub activity request failed")
        return response.json()
      })
      .then(({ contributions }) => {
        const recent = contributions.slice(-84)
        const grids = document.querySelectorAll("[data-github-activity]")

        grids.forEach((activityGrid) => {
          const cells = activityGrid.querySelectorAll("i")

          cells.forEach((cell, index) => {
            const day = recent[index]
            if (!day) return
            cell.style.setProperty("--level", String(day.level ?? 0))
            cell.title = `${day.date}: ${day.count} contribution${day.count === 1 ? "" : "s"}`
          })
        })
      })
      .catch(() => {
        document.querySelectorAll("[data-github-activity]").forEach((activityGrid) => {
          activityGrid.closest(".activity-card")?.setAttribute("data-unavailable", "")
        })
      })
  }
</script>
