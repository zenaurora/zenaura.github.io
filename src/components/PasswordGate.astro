---
type Props = {
  passwordHash: string
  storageKey: string
  scope: string
}

const { passwordHash, storageKey, scope } = Astro.props
---

<section
  data-password-gate
  data-password-hash={passwordHash}
  data-storage-key={storageKey}
  data-protected-scope={scope}
  aria-labelledby="password-gate-title"
>
  <p data-eyebrow>Protected ideas</p>
  <h1 id="password-gate-title">这里需要密码</h1>
  <p>这组研究想法暂不公开。输入密码后可在当前浏览器会话中查看。</p>
  <form>
    <label for="protected-content-password">密码</label>
    <input
      id="protected-content-password"
      name="password"
      type="password"
      autocomplete="current-password"
      required
      autofocus
    >
    <button type="submit">解锁</button>
  </form>
  <p data-password-error role="alert" hidden>密码不正确，请重试。</p>
</section>

<script>
  const encodeHash = async (value: string) => {
    const bytes = new TextEncoder().encode(value)
    const digest = await crypto.subtle.digest("SHA-256", bytes)
    return [...new Uint8Array(digest)]
      .map((byte) => byte.toString(16).padStart(2, "0"))
      .join("")
  }

  for (const gate of document.querySelectorAll<HTMLElement>(
    "[data-password-gate]",
  )) {
    const expectedHash = gate.dataset.passwordHash ?? ""
    const storageKey = gate.dataset.storageKey ?? "protected-content-access"
    const scope = gate.dataset.protectedScope ?? "protected-content"
    const form = gate.querySelector<HTMLFormElement>("form")
    const input = gate.querySelector<HTMLInputElement>("input")
    const button = gate.querySelector<HTMLButtonElement>("button")
    const error = gate.querySelector<HTMLElement>("[data-password-error]")

    const unlock = () => {
      gate.hidden = true
      for (const content of document.querySelectorAll<HTMLElement>(
        `[data-locked-content="${CSS.escape(scope)}"]`,
      )) {
        content.hidden = false
      }
    }

    try {
      if (sessionStorage.getItem(storageKey) === expectedHash) unlock()
    } catch {
      // Storage may be unavailable in hardened browsers; unlocking still works.
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault()
      if (!input || !button || !error) return

      button.disabled = true
      error.hidden = true

      try {
        const actualHash = await encodeHash(input.value)
        if (actualHash === expectedHash) {
          try {
            sessionStorage.setItem(storageKey, expectedHash)
          } catch {
            // Keep the page unlocked even when session storage is unavailable.
          }
          input.value = ""
          unlock()
          return
        }

        error.hidden = false
        input.select()
      } finally {
        button.disabled = false
      }
    })
  }
</script>

<style>
  section {
    max-inline-size: 30rem;
    margin-block-start: clamp(2rem, 9vh, 7rem);
    border-block-start: 2px solid var(--foreground);
    padding-block-start: var(--space-m);

    [data-eyebrow] {
      margin-block-end: var(--space-2xs);
      font-family: var(--font-mono);
      font-size: var(--step--1);
      color: var(--muted-foreground);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    h1 {
      font-size: var(--step-3);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
    }

    h1 + p {
      margin-block-start: var(--space-2xs);
      color: var(--muted-foreground);
    }
  }

  form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-2xs);
    margin-block-start: var(--space-l);

    label {
      grid-column: 1 / -1;
      font-size: var(--step--1);
      font-weight: var(--font-weight-medium);
    }

    input,
    button {
      min-block-size: 2.75rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-s);
      font: inherit;
    }

    input {
      min-inline-size: 0;
      padding-inline: var(--space-xs);
      color: var(--foreground);
      background: color-mix(in oklab, var(--background) 92%, var(--foreground));

      &:focus {
        border-color: var(--foreground);
      }
    }

    button {
      cursor: pointer;
      padding-inline: var(--space-s);
      color: var(--background);
      background: var(--foreground);

      &:disabled {
        cursor: wait;
        opacity: 0.55;
      }
    }
  }

  [data-password-error] {
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--danger, var(--foreground));
  }

  @media (width < 28rem) {
    form {
      grid-template-columns: 1fr;

      label {
        grid-column: auto;
      }
    }
  }
</style>
